<Window x:Class="ScreenshotTool.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图编辑" Width="1000" Height="720" MinWidth="640" MinHeight="480"
        Background="#FFF5F2FC" FontFamily="Microsoft YaHei UI" KeyDown="OnKeyDown">
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource PurpleButton}">
      <Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="12,0"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource PurpleComboBox}"/>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFD8CCFA" BorderThickness="0,0,0,1" Padding="9">
      <WrapPanel VerticalAlignment="Center">
        <Button Tag="Select" Click="OnToolClicked" Content="选择" Margin="0,0,6,0" />
        <Button Tag="Rectangle" Click="OnToolClicked" Content="矩形" Margin="0,0,6,0" />
        <Button Tag="RoundedRectangle" Click="OnToolClicked" Content="圆角矩形" Margin="0,0,6,0" />
        <Button Tag="Line" Click="OnToolClicked" Content="直线" Margin="0,0,6,0" />
        <Button Tag="Arrow" Click="OnToolClicked" Content="箭头" Margin="0,0,6,0" />
        <Button Tag="Pen" Click="OnToolClicked" Content="画笔" Margin="0,0,6,0" />
        <Button Tag="Text" Click="OnToolClicked" Content="文字" Margin="0,0,12,0" />
        <Button Tag="Red" Click="OnColorClicked" Width="34" Padding="0" Margin="0,0,4,0" ToolTip="红色"><Ellipse Width="18" Height="18" Fill="#FFE53935" Stroke="#FFB71C1C" StrokeThickness="1"/></Button>
        <Button Tag="Blue" Click="OnColorClicked" Width="34" Padding="0" Margin="0,0,4,0" ToolTip="蓝色"><Ellipse Width="18" Height="18" Fill="#FF1E88E5" Stroke="#FF0D47A1" StrokeThickness="1"/></Button>
        <Button Tag="Yellow" Click="OnColorClicked" Width="34" Padding="0" Margin="0,0,8,0" ToolTip="黄色"><Ellipse Width="18" Height="18" Fill="#FFFDD835" Stroke="#FFF9A825" StrokeThickness="1"/></Button>
        <TextBlock Text="粗细" VerticalAlignment="Center" />
        <ComboBox x:Name="ThicknessBox" Width="88" Height="34" SelectedIndex="1" SelectionChanged="OnThicknessChanged" Margin="4,0,12,0"><ComboBoxItem Content="2 px"/><ComboBoxItem Content="3 px"/><ComboBoxItem Content="5 px"/><ComboBoxItem Content="8 px"/></ComboBox>
        <Button Content="−" Click="OnZoomOutClicked" /><TextBlock x:Name="ZoomText" Width="48" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Click="OnZoomInClicked" Margin="0,0,12,0" />
        <Button Content="复制" Click="OnCopyClicked" Margin="0,0,6,0" /><Button Content="保存" Click="OnSaveClicked" Margin="0,0,6,0" /><Button Content="贴图" Click="OnPinClicked" />
      </WrapPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#FFF1EDFF" BorderBrush="#FFD8CCFA" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Foreground="#FF5E536C" /></StatusBar>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#303030">
      <Grid x:Name="ImageHost" HorizontalAlignment="Left" VerticalAlignment="Top" MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp">
        <Image x:Name="OriginalImage" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="AnnotationCanvas" Background="Transparent" />
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
