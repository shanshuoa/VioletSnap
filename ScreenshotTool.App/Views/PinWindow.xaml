<Window x:Class="ScreenshotTool.App.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        PreviewKeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseWheel="OnMouseWheel">
  <Window.Resources>
    <Style x:Key="ToolbarGlyph" TargetType="Path">
      <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
      <Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>
    <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#FCF8F5FF" BorderBrush="#FFD8CCFA" BorderThickness="1"
                    CornerRadius="10" Padding="6" MinWidth="176">
              <Border.Effect>
                <DropShadowEffect Color="#6B4E2A8E" BlurRadius="22" ShadowDepth="5" Opacity="0.42" />
              </Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="#FF443852" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuSurface" Background="Transparent" CornerRadius="6" Padding="10,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CheckGlyph" Text="✓" Visibility="Collapsed" Foreground="#FF7652D5"
                           FontWeight="Bold" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  VerticalAlignment="Center" Margin="2,0,16,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MenuSurface" Property="Background" Value="#FFEDE6FF" />
                <Setter Property="Foreground" Value="#FF5E3DB5" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#FFE4DCF0" VerticalAlignment="Center" /></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Window.ContextMenu>
    <ContextMenu Style="{StaticResource ModernContextMenu}">
      <MenuItem Header="复制" Click="OnCopyClicked" />
      <MenuItem Header="复制原图与标注" Click="OnCopyOriginal" />
      <MenuItem Header="复制上下对照图" Click="OnCopyComparison" />
      <MenuItem Header="保存" Click="OnSaveClicked" />
      <MenuItem x:Name="AnnotationMenuItem" Header="标注" IsCheckable="True" Click="OnAnnotationClicked" />
      <MenuItem Header="文字提取" Click="OnOcrClicked" />
      <MenuItem Header="翻译" Click="OnTranslateClicked" />
      <Separator />
      <MenuItem x:Name="BorderMenuItem" Header="显示边框" IsCheckable="True" IsChecked="True" Click="OnBorderClicked" />
      <MenuItem x:Name="TopmostMenuItem" Header="置顶" IsCheckable="True" IsChecked="True" Click="OnTopmostClicked" />
      <MenuItem x:Name="LockPositionMenuItem" Header="锁定位置" IsCheckable="True" />
      <MenuItem Header="恢复100%" Click="OnResetClicked" />
      <MenuItem Header="适应屏幕" Click="OnFitClicked" />
      <Separator />
      <MenuItem Header="关闭" Click="OnCloseClicked" />
    </ContextMenu>
  </Window.ContextMenu>
  <Grid x:Name="PinRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition x:Name="TranslationGapRow" Height="0" />
      <RowDefinition x:Name="TranslationRow" Height="0" />
    </Grid.RowDefinitions>
    <Border x:Name="ImageBorder" Grid.Row="0" BorderBrush="#FFB8A1FF" BorderThickness="1" Background="Transparent">
      <Grid>
        <Image x:Name="PinnedImage" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="AnnotationCanvas" Background="Transparent" IsHitTestVisible="False"
                MouseLeftButtonDown="OnAnnotationMouseDown" MouseMove="OnAnnotationMouseMove" MouseLeftButtonUp="OnAnnotationMouseUp" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#FFB79CFF" Margin="1,0" />
    <Border x:Name="TranslatedImageBorder" Grid.Row="2" Visibility="Collapsed" BorderBrush="#FFB8A1FF" BorderThickness="1" Background="Transparent">
      <Image x:Name="TranslatedPinnedImage" Stretch="Fill" IsHitTestVisible="False" />
    </Border>
    <Border x:Name="TranslationStatusPanel" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#F2FFFFFF" BorderBrush="#FFB79CFF" BorderThickness="1" CornerRadius="10" Padding="16,8">
      <Border.Effect><DropShadowEffect Color="#664E2A8E" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="✦" Foreground="#FF7652D5" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TranslationStatusText" Text="正在提取并翻译…" Foreground="#FF403650" FontSize="13" MaxWidth="300" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button x:Name="CancelTranslationButton" Content="取消" Style="{StaticResource PurpleButton}"
                Height="32" MinWidth="64" Padding="12,0" Click="OnCancelTranslation" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>
    <Popup x:Name="PinActionToolbar" PlacementTarget="{Binding ElementName=PinRoot}" Placement="Top"
           StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="#F7FFFFFF" BorderBrush="#FFB79CFF" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,0,8">
        <Border.Effect><DropShadowEffect Color="#704E2A8E" BlurRadius="16" ShadowDepth="3" Opacity="0.5"/></Border.Effect>
        <WrapPanel x:Name="ActionToolsPanel" Orientation="Horizontal">
          <Button x:Name="PinnedAnnotationButton" Style="{StaticResource ToolbarActionButton}" Content="标" ToolTip="标注" Click="OnPinnedAnnotationClicked" Margin="0,0,4,0"/>
          <Button Style="{StaticResource ToolbarActionButton}" Content="提" ToolTip="文字提取" Click="OnOcrClicked" Margin="0,0,4,0"/>
          <Button x:Name="TranslateActionButton" Style="{StaticResource ToolbarActionButton}" Content="翻" ToolTip="提取并翻译" Click="OnTranslateClicked" Margin="0,0,4,0"/>
          <StackPanel x:Name="TranslationTogglePanel" Visibility="Collapsed" Orientation="Horizontal">
            <Border Width="1" Height="24" Background="#FFD8CCFA" Margin="2,5,6,5"/>
            <Button x:Name="OriginalViewButton" Style="{StaticResource PurpleButton}" Content="收起" ToolTip="收起翻译图片" Click="OnShowOriginalClicked" Height="34" MinWidth="0" Padding="10,0" Margin="0,0,4,0" Background="White" Foreground="#FF5E536C" BorderBrush="#FFD8D1E3"/>
            <Button x:Name="TranslatedViewButton" Style="{StaticResource PurpleButton}" Content="展开" ToolTip="展开翻译图片" Click="OnShowTranslationClicked" Height="34" MinWidth="0" Padding="10,0" Margin="0,0,4,0"/>
            <Button x:Name="CopyTranslationButton" Style="{StaticResource PurpleButton}" Height="34" MinWidth="0" Padding="10,0" Content="复制译文" ToolTip="复制全部翻译文本" Click="OnCopyTranslationClicked" Margin="0,0,4,0" Background="White" Foreground="#FF5E536C" BorderBrush="#FFD8D1E3"/>
            <Button Style="{StaticResource PurpleButton}" Height="34" MinWidth="0" Padding="10,0" Content="重翻" ToolTip="使用当前设置重新翻译" Click="OnTranslateClicked" Margin="0,0,4,0"/>
          </StackPanel>
          <Button Style="{StaticResource ToolbarActionButton}" Content="复" ToolTip="展开时复制译图，收起时复制原图与标注" Click="OnCopyClicked" Margin="0,0,4,0"/>
          <Button Style="{StaticResource ToolbarActionButton}" Content="存" ToolTip="展开时保存译图，收起时保存原图与标注" Click="OnSaveClicked"/>
          <TextBlock x:Name="ScaleStatus" VerticalAlignment="Center" Foreground="#FF5E3DB5" Margin="6,0,0,0" FontSize="11"/>
        </WrapPanel>
      </Border>
    </Popup>
    <Popup x:Name="AnnotationToolbar" Grid.Row="0" PlacementTarget="{Binding ElementName=PinRoot}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
      <Popup.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
          <Setter Property="Width" Value="42" />
          <Setter Property="Height" Value="38" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="1,0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="#FF24282C" />
          <Setter Property="FontSize" Value="21" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                  <Grid>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="InteractionOverlay" Background="Transparent" CornerRadius="7" />
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InteractionOverlay" Property="Background" Value="#1FB79CFF" /></Trigger>
                  <Trigger Property="IsPressed" Value="True"><Setter TargetName="InteractionOverlay" Property="Background" Value="#3DB79CFF" /></Trigger>
                  <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="ToolSeparator" TargetType="Separator">
          <Setter Property="Width" Value="1" /><Setter Property="Height" Value="25" /><Setter Property="Margin" Value="6,0" />
          <Setter Property="Background" Value="#FFE4DCF0" />
        </Style>
      </Popup.Resources>
      <Border Background="#FFFDFEFF" BorderBrush="#FFB79CFF" BorderThickness="1" CornerRadius="8" Padding="5,4" Margin="0,8,0,0">
        <Border.Effect><DropShadowEffect BlurRadius="13" ShadowDepth="2" Opacity=".30" Color="#FF7253B6" /></Border.Effect>
        <StackPanel x:Name="AnnotationToolsPanel" Width="620">
          <WrapPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolButton}" Content="✥" PreviewMouseLeftButtonDown="OnMoveHandleMouseDown" ToolTip="拖动贴图"/>
            <Button Style="{StaticResource ToolButton}" Tag="Select" Click="OnToolClicked" Content="⌖" ToolTip="选择标注"/>
            <Button Style="{StaticResource ToolButton}" Tag="Rectangle" Click="OnToolClicked" ToolTip="矩形（Shift 正方形）"><Path Style="{StaticResource ToolbarGlyph}" Data="M2,3 L18,3 18,17 2,17 Z"/></Button>
            <Button Style="{StaticResource ToolButton}" Tag="RoundedRectangle" Click="OnToolClicked" ToolTip="圆角矩形"><Path Style="{StaticResource ToolbarGlyph}" Data="M5,2 L15,2 Q18,2 18,5 L18,15 Q18,18 15,18 L5,18 Q2,18 2,15 L2,5 Q2,2 5,2 Z"/></Button>
            <Button Style="{StaticResource ToolButton}" Tag="Line" Click="OnToolClicked" ToolTip="直线（Shift 约束角度）"><Path Style="{StaticResource ToolbarGlyph}" Data="M2,18 L18,2"/></Button>
            <Button Style="{StaticResource ToolButton}" Tag="Arrow" Click="OnToolClicked" ToolTip="箭头"><Path Style="{StaticResource ToolbarGlyph}" Data="M2,18 L18,2 M8,2 L18,2 18,12"/></Button>
            <Button Style="{StaticResource ToolButton}" Tag="Pen" Click="OnToolClicked" ToolTip="画笔"><Path Style="{StaticResource ToolbarGlyph}" Data="M2,18 L3,13 14,2 18,6 7,17 Z M11,5 L15,9"/></Button>
            <Button Style="{StaticResource ToolButton}" Tag="Text" Click="OnToolClicked" Content="T" FontWeight="SemiBold" ToolTip="文字"/>
            <Button Style="{StaticResource ToolButton}" Tag="Mosaic" Click="OnToolClicked" Content="▦" ToolTip="马赛克"/>
            <Button Style="{StaticResource ToolButton}" Tag="Blur" Click="OnToolClicked" Content="◌" ToolTip="模糊"/>
            <Separator Style="{StaticResource ToolSeparator}"/>
            <Button x:Name="UndoButton" Style="{StaticResource ToolButton}" Content="↶" Click="OnUndoClicked" ToolTip="撤销"/>
            <Button x:Name="RedoButton" Style="{StaticResource ToolButton}" Content="↷" Click="OnRedoClicked" ToolTip="重做"/>
            <Button Style="{StaticResource ToolButton}" Content="✓" Click="OnFinishAnnotationClicked" Foreground="#FF7652D5" ToolTip="完成标注并复制图片"/>
          </WrapPanel>
          <Border Height="1" Background="#FFE4DCF0" Margin="6,5"/>
          <WrapPanel Orientation="Horizontal">
            <ComboBox Style="{StaticResource PurpleComboBox}" Width="88" Height="36" Margin="2" SelectedIndex="0" SelectionChanged="OnColorChoiceChanged" ToolTip="标注颜色">
              <ComboBoxItem Content="红色" Tag="Red"/><ComboBoxItem Content="紫色" Tag="Purple"/><ComboBoxItem Content="蓝色" Tag="Blue"/><ComboBoxItem Content="黄色" Tag="Yellow"/><ComboBoxItem Content="黑色" Tag="Black"/><ComboBoxItem Content="白色" Tag="White"/>
            </ComboBox>
            <ComboBox x:Name="ThicknessBox" Style="{StaticResource PurpleComboBox}" Width="88" Height="36" Margin="2" SelectedIndex="1" SelectionChanged="OnThicknessChanged" ToolTip="线条粗细">
              <ComboBoxItem Content="2 px"/><ComboBoxItem Content="3 px"/><ComboBoxItem Content="5 px"/><ComboBoxItem Content="8 px"/>
            </ComboBox>
            <ComboBox x:Name="FontFamilyBox" Style="{StaticResource PurpleComboBox}" Width="172" Height="36" Margin="2" SelectedIndex="0" SelectionChanged="OnTextStyleChanged" ToolTip="标注字体">
              <ComboBoxItem Content="Microsoft YaHei"/><ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="SimSun"/>
            </ComboBox>
            <ComboBox x:Name="FontSizeBox" Style="{StaticResource PurpleComboBox}" Width="72" Height="36" Margin="2" SelectedIndex="2" SelectionChanged="OnTextStyleChanged" ToolTip="文字字号">
              <ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="32"/><ComboBoxItem Content="48"/>
            </ComboBox>
            <Button Style="{StaticResource ToolButton}" Content="B" FontWeight="Bold" Click="OnBoldClicked" ToolTip="粗体"/>
            <Button Style="{StaticResource ToolButton}" Content="色" Tag="Custom" Click="OnColorClicked" ToolTip="自定义颜色"/>
            <ComboBox Style="{StaticResource PurpleComboBox}" Width="82" Height="36" Margin="2" SelectedIndex="1" SelectionChanged="OnEffectStrengthChanged" ToolTip="效果强度：马赛克块大小 / 模糊半径">
              <ComboBoxItem Content="8"/><ComboBoxItem Content="12"/><ComboBoxItem Content="20"/><ComboBoxItem Content="32"/>
            </ComboBox>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
